<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TradingProject.Persistence.Api.Stubs</RootNamespace>
    <AssemblyName>TradingProject.Persistence.Api.Stubs</AssemblyName>
    <Description>Stub library for V1 API of TradingProject.Persistence. Provides contracts and stub implementations for other services.</Description>
    <PackageId>TradingProject.Persistence.Api.Stubs</PackageId>
    <Version>1.0.0$(VersionSuffix)</Version>
    <Authors>dot-trading</Authors>
    <Company>dot-trading</Company>
    <RepositoryUrl>https://github.com/dot-trading/trading-project-persistence</RepositoryUrl>
    <PackageTags>trading;persistence;stubs;v1</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath=""/>
  </ItemGroup>

  <!-- System.Text.Json is included in the .NET SDK -->

</Project>
